# CampusHire Configuration
PROJECT_NAME="CAMPUSHIRE - College Placement Management System"
API_V1_STR="/api"

# Security
# Generate a secure key in production (e.g., openssl rand -hex 32)
SECRET_KEY="campushire-insecure-dev-secret-key-change-in-production-minimum-32-bytes"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
# Path relative to backend root or absolute path
SQLITE_DB_PATH="data/campushire.db"

# CORS (comma-separated origins)
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173"
